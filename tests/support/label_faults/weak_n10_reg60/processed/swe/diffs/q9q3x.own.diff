+// validate ensures the redis TLS options are coherent. Namely, that the CA
+// bundle is sourced from exclusively one of the path or inline byte options.
+func (c *CacheConfig) validate() error {
+	if c.Redis.CaCertPath != "" && c.Redis.CaCertBytes != "" {
+		return errors.New("please provide exclusively one of ca_cert_bytes or ca_cert_path")
+	}
+
+	return nil
