diff --git a/internal/cache/redis/client.go b/internal/cache/redis/client.go
new file mode 100644
index 00000000..a4c9e8f3
--- /dev/null
+++ b/internal/cache/redis/client.go
@@ -0,0 +1,89 @@
+package redis
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"strconv"
+
+	goredis "github.com/redis/go-redis/v9"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// errNoCertificates is returned when a provided CA bundle does not contain
+// any parseable x509 certificates.
+var errNoCertificates = errors.New("no certificates found in CA bundle")
+
+// NewClient constructs a *goredis.Client from the supplied redis cache
+// configuration.
+//
+// When TLS is required, the client is configured to negotiate at least TLS 1.2
+// and to trust either the inline CA bundle (ca_cert_bytes), the CA bundle found
+// at the supplied path (ca_cert_path) or, when neither is provided, the trust
+// store of the underlying system. Verification of the server certificate can be
+// opted out of entirely with insecure_skip_tls.
+func NewClient(cfg config.RedisCacheConfig) (*goredis.Client, error) {
+	client := goredis.NewClient(&goredis.Options{
+		Addr:            net.JoinHostPort(cfg.Host, strconv.Itoa(cfg.Port)),
+		Username:        cfg.Username,
+		Password:        cfg.Password,
+		DB:              cfg.DB,
+		PoolSize:        cfg.PoolSize,
+		MinIdleConns:    cfg.MinIdleConn,
+		ConnMaxIdleTime: cfg.ConnMaxIdleTime,
+		DialTimeout:     cfg.NetTimeout,
+		ReadTimeout:     cfg.NetTimeout * 2,
+		WriteTimeout:    cfg.NetTimeout * 2,
+		PoolTimeout:     cfg.NetTimeout * 2,
+	})
+
+	if !cfg.RequireTLS {
+		return client, nil
+	}
+
+	tlsConfig := &tls.Config{
+		MinVersion:         tls.VersionTLS12,
+		InsecureSkipVerify: cfg.InsecureSkipTLS,
+	}
+
+	bundle, err := caBundle(cfg)
+	if err != nil {
+		return nil, err
+	}
+
+	if len(bundle) > 0 {
+		pool := x509.NewCertPool()
+		if !pool.AppendCertsFromPEM(bundle) {
+			return nil, errNoCertificates
+		}
+
+		tlsConfig.RootCAs = pool
+	}
+
+	client.Options().TLSConfig = tlsConfig
+
+	return client, nil
+}
+
+// caBundle resolves the CA bundle to trust from the provided configuration.
+// It returns a nil slice when the configuration does not source a custom CA
+// bundle, in which case the system certificate authorities are used.
+func caBundle(cfg config.RedisCacheConfig) ([]byte, error) {
+	if cfg.CaCertBytes != "" {
+		return []byte(cfg.CaCertBytes), nil
+	}
+
+	if cfg.CaCertPath != "" {
+		bundle, err := os.ReadFile(cfg.CaCertPath)
+		if err != nil {
+			return nil, fmt.Errorf("reading redis ca certificate: %w", err)
+		}
+
+		return bundle, nil
+	}
+
+	return nil, nil
+}
diff --git a/internal/cache/redis/client_test.go b/internal/cache/redis/client_test.go
new file mode 100644
index 00000000..e2b984e9
--- /dev/null
+++ b/internal/cache/redis/client_test.go
@@ -0,0 +1,270 @@
+package redis
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"fmt"
+	"math/big"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	goredis "github.com/redis/go-redis/v9"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// testCerts holds a throwaway certificate authority and a leaf certificate
+// signed by it, which is served by the in-memory TLS listener below.
+type testCerts struct {
+	caPEM  string
+	server tls.Certificate
+}
+
+func newTestCerts(t *testing.T) testCerts {
+	t.Helper()
+
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+
+	serial, err := rand.Int(rand.Reader, new(big.Int).Lsh(big.NewInt(1), 128))
+	require.NoError(t, err)
+
+	tmpl := &x509.Certificate{
+		SerialNumber:          serial,
+		Subject:               pkix.Name{CommonName: "flipt-redis-test-ca"},
+		NotBefore:             time.Now().Add(-time.Hour),
+		NotAfter:              time.Now().Add(time.Hour),
+		IsCA:                  true,
+		KeyUsage:              x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature,
+		BasicConstraintsValid: true,
+	}
+
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	require.NoError(t, err)
+
+	caPEM := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
+
+	pool := x509.NewCertPool()
+	require.True(t, pool.AppendCertsFromPEM(caPEM))
+
+	leaf, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+
+	leafTmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(2),
+		Subject:      pkix.Name{CommonName: "localhost"},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+		DNSNames:     []string{"localhost"},
+		IPAddresses:  []net.IP{net.ParseIP("127.0.0.1"), net.ParseIP("::1")},
+		KeyUsage:     x509.KeyUsageDigitalSignature | x509.KeyUsageKeyEncipherment,
+		ExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+	}
+
+	leafDER, err := x509.CreateCertificate(rand.Reader, leafTmpl, tmpl, &leaf.PublicKey, key)
+	require.NoError(t, err)
+
+	cert := tls.Certificate{
+		Certificate: [][]byte{leafDER},
+		PrivateKey:  leaf,
+	}
+
+	return testCerts{caPEM: string(caPEM), server: cert}
+}
+
+// listen starts a TLS server on a free local port and returns its address.
+func (c testCerts) listen(t *testing.T) string {
+	t.Helper()
+
+	listener, err := tls.Listen("tcp", "127.0.0.1:0", &tls.Config{
+		Certificates: []tls.Certificate{c.server},
+		MinVersion:   tls.VersionTLS12,
+	})
+	require.NoError(t, err)
+
+	t.Cleanup(func() { _ = listener.Close() })
+
+	accepted := make(chan struct{})
+	go func() {
+		defer close(accepted)
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			// drive the handshake, then hang up
+			_ = conn.(*tls.Conn).Handshake()
+			_ = conn.Close()
+		}
+	}()
+
+	return listener.Addr().String()
+}
+
+// connectUsing performs a TLS handshake against addr using the client options
+// configured for the supplied redis client.
+func connectUsing(t *testing.T, client *goredis.Client, addr string) error {
+	t.Helper()
+
+	cfg := client.Options().TLSConfig.Clone()
+	cfg.ServerName = "localhost"
+
+	conn, err := tls.Dial("tcp", addr, cfg)
+	if err != nil {
+		return err
+	}
+
+	return conn.Close()
+}
+
+func TestNewClient(t *testing.T) {
+	var (
+		certs = newTestCerts(t)
+		addr  = certs.listen(t)
+	)
+
+	host, port, err := net.SplitHostPort(addr)
+	require.NoError(t, err)
+
+	caPath := filepath.Join(t.TempDir(), "ca.pem")
+	require.NoError(t, os.WriteFile(caPath, []byte(certs.caPEM), 0600))
+
+	base := func() config.RedisCacheConfig {
+		return config.RedisCacheConfig{
+			Host: host,
+			Port: mustAtoi(t, port),
+		}
+	}
+
+	t.Run("tls disabled", func(t *testing.T) {
+		client, err := NewClient(base())
+		require.NoError(t, err)
+		require.NotNil(t, client)
+		defer func() { _ = client.Close() }()
+
+		assert.Nil(t, client.Options().TLSConfig)
+		assert.Equal(t, addr, client.Options().Addr)
+	})
+
+	t.Run("require tls defaults to system roots", func(t *testing.T) {
+		cfg := base()
+		cfg.RequireTLS = true
+
+		client, err := NewClient(cfg)
+		require.NoError(t, err)
+		defer func() { _ = client.Close() }()
+
+		tlsConfig := client.Options().TLSConfig
+		require.NotNil(t, tlsConfig)
+		assert.Equal(t, uint16(tls.VersionTLS12), tlsConfig.MinVersion)
+		assert.Nil(t, tlsConfig.RootCAs, "no custom roots should be attached")
+		assert.False(t, tlsConfig.InsecureSkipVerify)
+
+		// the listener serves a self-signed certificate, which the system
+		// trust store cannot verify.
+		err = connectUsing(t, client, addr)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "certificate signed by unknown authority")
+	})
+
+	t.Run("ca_cert_path is trusted", func(t *testing.T) {
+		cfg := base()
+		cfg.RequireTLS = true
+		cfg.CaCertPath = caPath
+
+		client, err := NewClient(cfg)
+		require.NoError(t, err)
+		defer func() { _ = client.Close() }()
+
+		require.NotNil(t, client.Options().TLSConfig.RootCAs)
+		require.NoError(t, connectUsing(t, client, addr))
+	})
+
+	t.Run("ca_cert_bytes is trusted", func(t *testing.T) {
+		cfg := base()
+		cfg.RequireTLS = true
+		cfg.CaCertBytes = certs.caPEM
+
+		client, err := NewClient(cfg)
+		require.NoError(t, err)
+		defer func() { _ = client.Close() }()
+
+		require.NotNil(t, client.Options().TLSConfig.RootCAs)
+		require.NoError(t, connectUsing(t, client, addr))
+	})
+
+	t.Run("insecure_skip_tls skips verification", func(t *testing.T) {
+		cfg := base()
+		cfg.RequireTLS = true
+		cfg.InsecureSkipTLS = true
+
+		client, err := NewClient(cfg)
+		require.NoError(t, err)
+		defer func() { _ = client.Close() }()
+
+		require.NotNil(t, client.Options().TLSConfig)
+		assert.True(t, client.Options().TLSConfig.InsecureSkipVerify)
+		assert.Nil(t, client.Options().TLSConfig.RootCAs)
+		require.NoError(t, connectUsing(t, client, addr))
+	})
+
+	t.Run("missing ca_cert_path", func(t *testing.T) {
+		cfg := base()
+		cfg.RequireTLS = true
+		cfg.CaCertPath = filepath.Join(t.TempDir(), "does-not-exist.pem")
+
+		client, err := NewClient(cfg)
+		require.Error(t, err)
+		assert.Nil(t, client)
+		assert.Contains(t, err.Error(), "no such file or directory")
+	})
+
+	t.Run("malformed ca bundle", func(t *testing.T) {
+		cfg := base()
+		cfg.RequireTLS = true
+		cfg.CaCertBytes = "-----BEGIN CERTIFICATE-----\nnot a certificate\n-----END CERTIFICATE-----\n"
+
+		client, err := NewClient(cfg)
+		require.Error(t, err)
+		assert.Nil(t, client)
+	})
+}
+
+func TestNewClient_credentials(t *testing.T) {
+	cfg := config.RedisCacheConfig{
+		Host:     "redis",
+		Port:     6379,
+		Username: "app",
+		Password: "s3cr3t!",
+		DB:       1,
+	}
+
+	client, err := NewClient(cfg)
+	require.NoError(t, err)
+	defer func() { _ = client.Close() }()
+
+	opts := client.Options()
+	assert.Equal(t, "redis:6379", opts.Addr)
+	assert.Equal(t, "app", opts.Username)
+	assert.Equal(t, "s3cr3t!", opts.Password)
+	assert.Equal(t, 1, opts.DB)
+}
+
+func mustAtoi(t *testing.T, s string) int {
+	t.Helper()
+
+	var i int
+	_, err := fmt.Sscanf(s, "%d", &i)
+	require.NoError(t, err)
+
+	return i
+}
