@@ -102,4 +104,24 @@ type RedisCacheConfig struct {
 	MinIdleConn     int           `json:"minIdleConn" mapstructure:"min_idle_conn" yaml:"min_idle_conn"`
 	ConnMaxIdleTime time.Duration `json:"connMaxIdleTime" mapstructure:"conn_max_idle_time" yaml:"conn_max_idle_time"`
 	NetTimeout      time.Duration `json:"netTimeout" mapstructure:"net_timeout" yaml:"net_timeout"`
+
+	// CaCertPath is the path to an optional x509 CA certificate bundle, which
+	// is trusted when connecting to a TLS enabled redis server.
+	CaCertPath string `json:"caCertPath,omitempty" mapstructure:"ca_cert_path" yaml:"ca_cert_path,omitempty"`
+	// CaCertBytes is an inline x509 CA certificate bundle, which is trusted when
+	// connecting to a TLS enabled redis server. It is mutually exclusive with CaCertPath.
+	CaCertBytes string `json:"-" mapstructure:"ca_cert_bytes" yaml:"-"`
+	// InsecureSkipTLS skips the verification of the server certificate when
