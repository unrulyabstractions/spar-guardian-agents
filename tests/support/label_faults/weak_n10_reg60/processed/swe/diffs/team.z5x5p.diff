diff --git a/internal/config/redis_tls_test.go b/internal/config/redis_tls_test.go
new file mode 100644
index 00000000..3bbb7b39
--- /dev/null
+++ b/internal/config/redis_tls_test.go
@@ -0,0 +1,123 @@
+package config
+
+import (
+	"context"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestRedisCacheTLS_yaml asserts that the redis TLS options are surfaced from
+// configuration files into the RedisCacheConfig.
+func TestRedisCacheTLS_yaml(t *testing.T) {
+	ca, err := os.ReadFile("./testdata/redis/ca.pem")
+	require.NoError(t, err)
+
+	tests := []struct {
+		name     string
+		path     string
+		expected func() RedisCacheConfig
+		wantErr  string
+	}{
+		{
+			name: "ca cert path",
+			path: "./testdata/cache/redis-ca-path.yml",
+			expected: func() RedisCacheConfig {
+				cfg := Default().Cache.Redis
+				cfg.Host = "redis"
+				cfg.RequireTLS = true
+				cfg.CaCertPath = "./testdata/redis/ca.pem"
+				return cfg
+			},
+		},
+		{
+			name: "ca cert bytes",
+			path: "./testdata/cache/redis-ca-bytes.yml",
+			expected: func() RedisCacheConfig {
+				cfg := Default().Cache.Redis
+				cfg.Host = "redis"
+				cfg.RequireTLS = true
+				cfg.CaCertBytes = string(ca)
+				return cfg
+			},
+		},
+		{
+			name: "insecure",
+			path: "./testdata/cache/redis-tls-insecure.yml",
+			expected: func() RedisCacheConfig {
+				cfg := Default().Cache.Redis
+				cfg.Host = "redis"
+				cfg.RequireTLS = true
+				cfg.InsecureSkipTLS = true
+				return cfg
+			},
+		},
+		{
+			name:    "both ca bundle sources are invalid",
+			path:    "./testdata/cache/redis-ca-invalid.yml",
+			wantErr: "please provide exclusively one of ca_cert_bytes or ca_cert_path",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			res, err := Load(context.Background(), tt.path)
+
+			if tt.wantErr != "" {
+				require.Error(t, err)
+				assert.Equal(t, tt.wantErr, err.Error())
+				return
+			}
+
+			require.NoError(t, err)
+			assert.Equal(t, tt.expected(), res.Config.Cache.Redis)
+		})
+	}
+}
+
+// TestRedisCacheTLS_defaults asserts the zero value of the new options so that
+// TLS stays off unless an operator asks for it.
+func TestRedisCacheTLS_defaults(t *testing.T) {
+	cfg := Default()
+
+	assert.False(t, cfg.Cache.Redis.RequireTLS)
+	assert.False(t, cfg.Cache.Redis.InsecureSkipTLS)
+	assert.Empty(t, cfg.Cache.Redis.CaCertPath)
+	assert.Empty(t, cfg.Cache.Redis.CaCertBytes)
+
+	assert.NoError(t, cfg.Cache.Redis.validate())
+	assert.Equal(t, 1*time.Minute, cfg.Cache.TTL)
+}
+
+// TestRedisCacheTLS_env asserts that the new options can be provided entirely
+// through the environment, as Flipt is usually deployed with env vars.
+func TestRedisCacheTLS_env(t *testing.T) {
+	backup := os.Environ()
+	defer func() {
+		os.Clearenv()
+		for _, env := range backup {
+			key, value, _ := strings.Cut(env, "=")
+			os.Setenv(key, value)
+		}
+	}()
+
+	os.Setenv("FLIPT_CACHE_ENABLED", "true")
+	os.Setenv("FLIPT_CACHE_BACKEND", "redis")
+	os.Setenv("FLIPT_CACHE_REDIS_REQUIRE_TLS", "true")
+	os.Setenv("FLIPT_CACHE_REDIS_CA_CERT_PATH", "./testdata/redis/ca.pem")
+
+	res, err := Load(context.Background(), "./testdata/default.yml")
+	require.NoError(t, err)
+
+	assert.True(t, res.Config.Cache.Redis.RequireTLS)
+	assert.Equal(t, "./testdata/redis/ca.pem", res.Config.Cache.Redis.CaCertPath)
+
+	os.Setenv("FLIPT_CACHE_REDIS_CA_CERT_BYTES", "inline bundle")
+	_, err = Load(context.Background(), "./testdata/default.yml")
+	require.Error(t, err)
+	assert.Equal(t, "please provide exclusively one of ca_cert_bytes or ca_cert_path", err.Error())
+}
