diff --git a/internal/cache/redis/client.go b/internal/cache/redis/client.go
new file mode 100644
index 00000000..f4af877a
--- /dev/null
+++ b/internal/cache/redis/client.go
@@ -0,0 +1,96 @@
+package redis
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"os"
+
+	goredis "github.com/redis/go-redis/v9"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// NewClient constructs a redis client from the supplied configuration.
+//
+// When require_tls is set the client speaks at least TLS1.2 and trusts whichever
+// certificate authority was configured, either inline (ca_cert_bytes) or from disk
+// (ca_cert_path). When no CA is configured the operating systems trust store is used
+// and when insecure_skip_tls is set the servers certificate is not verified at all.
+func NewClient(cfg config.RedisCacheConfig) (*goredis.Client, error) {
+	tlsCfg, err := tlsConfig(cfg)
+	if err != nil {
+		return nil, err
+	}
+
+	return goredis.NewClient(&goredis.Options{
+		Addr:            fmt.Sprintf("%s:%d", cfg.Host, cfg.Port),
+		TLSConfig:       tlsCfg,
+		Username:        cfg.Username,
+		Password:        cfg.Password,
+		DB:              cfg.DB,
+		PoolSize:        cfg.PoolSize,
+		MinIdleConns:    cfg.MinIdleConn,
+		ConnMaxIdleTime: cfg.ConnMaxIdleTime,
+		DialTimeout:     cfg.NetTimeout,
+		ReadTimeout:     cfg.NetTimeout * 2,
+		WriteTimeout:    cfg.NetTimeout * 2,
+		PoolTimeout:     cfg.NetTimeout * 2,
+	}), nil
+}
+
+// tlsConfig builds the client side TLS configuration for a redis connection.
+// It returns a nil config when the connection is not expected to be encrypted.
+func tlsConfig(cfg config.RedisCacheConfig) (*tls.Config, error) {
+	if !cfg.RequireTLS {
+		return nil, nil
+	}
+
+	tlsCfg := &tls.Config{
+		MinVersion:         tls.VersionTLS12,
+		InsecureSkipVerify: cfg.InsecureSkipTLS, //nolint:gosec // explicitly requested via configuration
+	}
+
+	// when verification is turned off there is no CA to attach
+	if cfg.InsecureSkipTLS {
+		return tlsCfg, nil
+	}
+
+	bundle, err := caBundle(cfg)
+	if err != nil {
+		return nil, err
+	}
+
+	// no CA was configured, fall back to the system trust store
+	if len(bundle) == 0 {
+		return tlsCfg, nil
+	}
+
+	pool := x509.NewCertPool()
+	if !pool.AppendCertsFromPEM(bundle) {
+		return nil, errors.New("unable to parse redis CA certificate bundle")
+	}
+	tlsCfg.RootCAs = pool
+
+	return tlsCfg, nil
+}
+
+// caBundle returns the PEM encoded certificate to trust for the connection.
+// Inline configured certificates take precedence over a path. It returns nil
+// when the operator configured neither.
+func caBundle(cfg config.RedisCacheConfig) ([]byte, error) {
+	if cfg.CaCertBytes != "" {
+		return []byte(cfg.CaCertBytes), nil
+	}
+
+	if cfg.CaCertPath != "" {
+		out, err := os.ReadFile(cfg.CaCertPath)
+		if err != nil {
+			return nil, fmt.Errorf("reading redis CA certificate: %w", err)
+		}
+
+		return out, nil
+	}
+
+	return nil, nil
+}
diff --git a/internal/cache/redis/client_test.go b/internal/cache/redis/client_test.go
new file mode 100644
index 00000000..d0fd3871
--- /dev/null
+++ b/internal/cache/redis/client_test.go
@@ -0,0 +1,282 @@
+package redis
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"fmt"
+	"math/big"
+	"net"
+	"os"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// ca is a throw away certificate authority and the leaf it signed, both keyed
+// for the loopback address the tests below dial.
+type ca struct {
+	// bundle is the PEM encoded authority certificate, which clients trust.
+	bundle string
+	// certificate and key are the leaf the test server presents.
+	certificate string
+	key         string
+}
+
+func newCertificateAuthority(t *testing.T) ca {
+	t.Helper()
+
+	signer, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+
+	serialLimit := new(big.Int).Lsh(big.NewInt(1), 128)
+	serial, err := rand.Int(rand.Reader, serialLimit)
+	require.NoError(t, err)
+
+	template := &x509.Certificate{
+		SerialNumber:          serial,
+		Subject:               pkix.Name{CommonName: "flipt-redis-test-ca"},
+		NotBefore:             time.Now().Add(-time.Hour),
+		NotAfter:              time.Now().Add(time.Hour),
+		KeyUsage:              x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature,
+		BasicConstraintsValid: true,
+		IsCA:                  true,
+	}
+
+	bundle, err := x509.CreateCertificate(rand.Reader, template, template, &signer.PublicKey, signer)
+	require.NoError(t, err)
+
+	leaf, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+
+	serial, err = rand.Int(rand.Reader, serialLimit)
+	require.NoError(t, err)
+
+	leafTemplate := &x509.Certificate{
+		SerialNumber: serial,
+		Subject:      pkix.Name{CommonName: "redis"},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+		KeyUsage:     x509.KeyUsageDigitalSignature | x509.KeyUsageKeyEncipherment,
+		ExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+		IPAddresses:  []net.IP{net.ParseIP("127.0.0.1")},
+		DNSNames:     []string{"localhost"},
+	}
+
+	leafDER, err := x509.CreateCertificate(rand.Reader, leafTemplate, template, &leaf.PublicKey, signer)
+	require.NoError(t, err)
+
+	keyDER, err := x509.MarshalPKCS8PrivateKey(leaf)
+	require.NoError(t, err)
+
+	return ca{
+		bundle:      string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: bundle})),
+		certificate: string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: leafDER})),
+		key:         string(pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: keyDER})),
+	}
+}
+
+// startTLSServer serves TLS on a random loopback port, mimicking a redis
+// server which only accepts encrypted connections.
+func startTLSServer(t *testing.T, authority ca) string {
+	t.Helper()
+
+	pair, err := tls.X509KeyPair([]byte(authority.certificate), []byte(authority.key))
+	require.NoError(t, err)
+
+	listener, err := tls.Listen("tcp", "127.0.0.1:0", &tls.Config{
+		Certificates: []tls.Certificate{pair},
+		MinVersion:   tls.VersionTLS12,
+	})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = listener.Close() })
+
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+
+			go func() {
+				// swallow the payload, we only care that the handshake was permitted
+				_ = conn.(*tls.Conn).Handshake()
+				_ = conn.Close()
+			}()
+		}
+	}()
+
+	return fmt.Sprintf("%s:%d", "127.0.0.1", listener.Addr().(*net.TCPAddr).Port)
+}
+
+// atoi is a small helper for turning the port of a loopback address into an int.
+func atoi(t *testing.T, port string) int {
+	t.Helper()
+
+	n, err := strconv.Atoi(port)
+	require.NoError(t, err)
+
+	return n
+}
+
+func TestNewClient_withoutTLS(t *testing.T) {
+	client, err := NewClient(config.RedisCacheConfig{Host: "localhost", Port: 6379})
+	require.NoError(t, err)
+	require.NotNil(t, client)
+
+	assert.Nil(t, client.Options().TLSConfig, "expected no TLS configuration")
+	assert.Equal(t, "localhost:6379", client.Options().Addr)
+	require.NoError(t, client.Close())
+}
+
+func TestNewClient_options(t *testing.T) {
+	client, err := NewClient(config.RedisCacheConfig{
+		Host:            "localhost",
+		Port:            6379,
+		Username:        "app",
+		Password:        "s3cr3t!",
+		DB:              1,
+		PoolSize:        50,
+		MinIdleConn:     2,
+		ConnMaxIdleTime: 10 * time.Minute,
+		NetTimeout:      500 * time.Millisecond,
+	})
+	require.NoError(t, err)
+	defer client.Close()
+
+	opts := client.Options()
+	assert.Equal(t, "app", opts.Username)
+	assert.Equal(t, "s3cr3t!", opts.Password)
+	assert.Equal(t, 1, opts.DB)
+	assert.Equal(t, 50, opts.PoolSize)
+	assert.Equal(t, 2, opts.MinIdleConns)
+	assert.Equal(t, 10*time.Minute, opts.ConnMaxIdleTime)
+	assert.Equal(t, 500*time.Millisecond, opts.DialTimeout)
+	assert.Equal(t, time.Second, opts.ReadTimeout)
+	assert.Equal(t, time.Second, opts.WriteTimeout)
+	assert.Equal(t, time.Second, opts.PoolTimeout)
+}
+
+func TestNewClient_tls(t *testing.T) {
+	var (
+		authority = newCertificateAuthority(t)
+		addr      = startTLSServer(t, authority)
+		dir       = t.TempDir()
+	)
+
+	require.NoError(t, os.WriteFile(dir+"/ca.pem", []byte(authority.bundle), 0600))
+	require.NoError(t, os.WriteFile(dir+"/not-a-ca.pem", []byte("i am not a certificate"), 0600))
+
+	host, port, err := net.SplitHostPort(addr)
+	require.NoError(t, err)
+
+	tests := []struct {
+		name               string
+		config             func() config.RedisCacheConfig
+		expectClientErr    bool
+		expectHandshakeErr bool
+	}{
+		{
+			name: "trusted CA from path",
+			config: func() config.RedisCacheConfig {
+				return config.RedisCacheConfig{RequireTLS: true, CaCertPath: dir + "/ca.pem"}
+			},
+		},
+		{
+			name: "trusted CA from bytes",
+			config: func() config.RedisCacheConfig {
+				return config.RedisCacheConfig{RequireTLS: true, CaCertBytes: authority.bundle}
+			},
+		},
+		{
+			name: "skipping verification",
+			config: func() config.RedisCacheConfig {
+				return config.RedisCacheConfig{RequireTLS: true, InsecureSkipTLS: true}
+			},
+		},
+		{
+			name: "system trust store",
+			config: func() config.RedisCacheConfig {
+				return config.RedisCacheConfig{RequireTLS: true}
+			},
+			expectHandshakeErr: true,
+		},
+		{
+			name: "missing CA file",
+			config: func() config.RedisCacheConfig {
+				return config.RedisCacheConfig{RequireTLS: true, CaCertPath: dir + "/does-not-exist.pem"}
+			},
+			expectClientErr: true,
+		},
+		{
+			name: "CA file which is not a certificate",
+			config: func() config.RedisCacheConfig {
+				return config.RedisCacheConfig{RequireTLS: true, CaCertPath: dir + "/not-a-ca.pem"}
+			},
+			expectClientErr: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cfg := tt.config()
+			cfg.Host, cfg.Port = host, atoi(t, port)
+
+			client, err := NewClient(cfg)
+			if tt.expectClientErr {
+				require.Error(t, err)
+				require.Nil(t, client)
+				return
+			}
+			require.NoError(t, err)
+			defer client.Close()
+
+			tlsCfg := client.Options().TLSConfig
+			require.NotNil(t, tlsCfg, "expected the client to be configured for TLS")
+			assert.Equal(t, uint16(tls.VersionTLS12), tlsCfg.MinVersion)
+
+			conn, err := net.DialTimeout("tcp", addr, time.Second)
+			require.NoError(t, err)
+
+			// go-redis derives the ServerName from the address it dials, mirror that here
+			dialCfg := tlsCfg.Clone()
+			dialCfg.ServerName = "localhost"
+
+			tlsConn := tls.Client(conn, dialCfg)
+			defer tlsConn.Close()
+
+			if tt.expectHandshakeErr {
+				require.Error(t, tlsConn.Handshake(), "expected the handshake to fail")
+				return
+			}
+
+			require.NoError(t, tlsConn.Handshake())
+			assert.GreaterOrEqual(t, tlsConn.ConnectionState().Version, uint16(tls.VersionTLS12))
+		})
+	}
+}
+
+func TestNewClient_insecureSkipsCAs(t *testing.T) {
+	client, err := NewClient(config.RedisCacheConfig{
+		Host:            "localhost",
+		Port:            6379,
+		RequireTLS:      true,
+		CaCertBytes:     "garbage",
+		InsecureSkipTLS: true,
+	})
+	require.NoError(t, err)
+	defer client.Close()
+
+	tlsCfg := client.Options().TLSConfig
+	require.NotNil(t, tlsCfg)
+	assert.True(t, tlsCfg.InsecureSkipVerify)
+	assert.Nil(t, tlsCfg.RootCAs)
+}
