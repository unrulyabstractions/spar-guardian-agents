+package redis
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+)
+
+func TestNewClientTLSOptions(t *testing.T) {
+	t.Run("no tls", func(t *testing.T) {
+		c, err := NewClient(config.RedisCacheConfig{Host: "localhost", Port: 6379})
+		require.NoError(t, err)
+		assert.Nil(t, c.Options().TLSConfig)
+		_ = c.Close()
+	})
+
+	t.Run("tls min version", func(t *testing.T) {
+		c, err := NewClient(config.RedisCacheConfig{Host: "localhost", Port: 6379, RequireTLS: true})
+		require.NoError(t, err)
+		require.NotNil(t, c.Options().TLSConfig)
+		assert.Equal(t, uint16(0x0303), c.Options().TLSConfig.MinVersion)
+		assert.False(t, c.Options().TLSConfig.InsecureSkipVerify)
+		_ = c.Close()
+	})
+
+	t.Run("insecure skip", func(t *testing.T) {
+		c, err := NewClient(config.RedisCacheConfig{Host: "localhost", Port: 6379, RequireTLS: true, InsecureSkipTLS: true})
+		require.NoError(t, err)
+		assert.True(t, c.Options().TLSConfig.InsecureSkipVerify)
+		_ = c.Close()
+	})
+
+	t.Run("invalid ca bytes", func(t *testing.T) {
+		_, err := NewClient(config.RedisCacheConfig{Host: "localhost", Port: 6379, RequireTLS: true, CaCertBytes: "not a pem"})
+		assert.Error(t, err)
+	})
+}
