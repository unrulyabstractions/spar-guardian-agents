+	require.NotNil(t, tc.RootCAs)
+}
+
+func TestNewClient_TLSInsecureSkipWithCA(t *testing.T) {
+	tc := tlsOf(t, config.RedisCacheConfig{Host: "h", Port: 1, RequireTLS: true, InsecureSkipTLS: true, CaCertBytes: testCertPEM(t)})
+	assert.True(t, tc.InsecureSkipVerify)
+	require.NotNil(t, tc.RootCAs)
+}
+
+func TestNewClient_TLSInsecureSkipCAPathMissing(t *testing.T) {
+	_, err := NewClient(config.RedisCacheConfig{RequireTLS: true, InsecureSkipTLS: true, CaCertPath: "/nonexistent/ca.pem"})
 	assert.Error(t, err)
 }
 
