index 00000000..74a6f1ca
--- /dev/null
+++ b/internal/cache/redis/client.go
@@ -0,0 +1,66 @@
+package redis
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"fmt"
+	"os"
+
+	goredis "github.com/redis/go-redis/v9"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// NewClient constructs a redis client from the provided configuration.
+// When RequireTLS is enabled, the connection uses TLS with a minimum version of TLS 1.2.
+// A custom CA may be supplied via CaCertPath or CaCertBytes (exclusively),
+// otherwise system certificate authorities are used. InsecureSkipTLS disables
+// server certificate verification.
+func NewClient(cfg config.RedisCacheConfig) (*goredis.Client, error) {
+	var tlsConfig *tls.Config
+	if cfg.RequireTLS {
+		tlsConfig = &tls.Config{
+			MinVersion: tls.VersionTLS12,
+		}
+
+		if cfg.InsecureSkipTLS {
+			tlsConfig.InsecureSkipVerify = true //nolint:gosec
+		} else {
+			var caCert []byte
+			switch {
+			case cfg.CaCertPath != "" && cfg.CaCertBytes != "":
+				return nil, fmt.Errorf("please provide exclusively one of ca_cert_bytes or ca_cert_path")
+			case cfg.CaCertPath != "":
+				data, err := os.ReadFile(cfg.CaCertPath)
+				if err != nil {
+					return nil, fmt.Errorf("reading redis ca cert: %w", err)
+				}
+				caCert = data
+			case cfg.CaCertBytes != "":
+				caCert = []byte(cfg.CaCertBytes)
+			}
+
+			if len(caCert) > 0 {
+				pool := x509.NewCertPool()
+				if !pool.AppendCertsFromPEM(caCert) {
+					return nil, fmt.Errorf("failed to parse redis ca certificate")
+				}
+				tlsConfig.RootCAs = pool
+			}
+		}
+	}
+
+	return goredis.NewClient(&goredis.Options{
+		Addr:            fmt.Sprintf("%s:%d", cfg.Host, cfg.Port),
+		TLSConfig:       tlsConfig,
+		Username:        cfg.Username,
+		Password:        cfg.Password,
+		DB:              cfg.DB,
+		PoolSize:        cfg.PoolSize,
+		MinIdleConns:    cfg.MinIdleConn,
+		ConnMaxIdleTime: cfg.ConnMaxIdleTime,
+		DialTimeout:     cfg.NetTimeout,
+		ReadTimeout:     cfg.NetTimeout * 2,
+		WriteTimeout:    cfg.NetTimeout * 2,
+		PoolTimeout:     cfg.NetTimeout * 2,
+	}), nil
+}
diff --git a/internal/cache/redis/client_test.go b/internal/cache/redis/client_test.go
new file mode 100644
index 00000000..7b94ae96
--- /dev/null
+++ b/internal/cache/redis/client_test.go
@@ -0,0 +1,88 @@
+package redis
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"math/big"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+)
+
+func testCertPEM(t *testing.T) string {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	tmpl := &x509.Certificate{
+		SerialNumber:          big.NewInt(1),
+		Subject:               pkix.Name{CommonName: "redis-test-ca"},
+		NotBefore:             time.Now().Add(-time.Hour),
+		NotAfter:              time.Now().Add(time.Hour),
+		IsCA:                  true,
+		BasicConstraintsValid: true,
+		KeyUsage:              x509.KeyUsageCertSign,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	require.NoError(t, err)
+	return string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}))
+}
+
+func tlsOf(t *testing.T, cfg config.RedisCacheConfig) *tls.Config {
+	t.Helper()
+	rdb, err := NewClient(cfg)
+	require.NoError(t, err)
+	defer rdb.Close()
+	return rdb.Options().TLSConfig
+}
+
+func TestNewClient_NoTLS(t *testing.T) {
+	assert.Nil(t, tlsOf(t, config.RedisCacheConfig{Host: "h", Port: 1}))
+}
+
+func TestNewClient_TLSSystemCAs(t *testing.T) {
+	tc := tlsOf(t, config.RedisCacheConfig{Host: "h", Port: 1, RequireTLS: true})
+	require.NotNil(t, tc)
+	assert.Equal(t, uint16(tls.VersionTLS12), tc.MinVersion)
+	assert.Nil(t, tc.RootCAs)
+	assert.False(t, tc.InsecureSkipVerify)
+}
+
+func TestNewClient_TLSCABytes(t *testing.T) {
+	tc := tlsOf(t, config.RedisCacheConfig{Host: "h", Port: 1, RequireTLS: true, CaCertBytes: testCertPEM(t)})
+	require.NotNil(t, tc.RootCAs)
+	assert.False(t, tc.InsecureSkipVerify)
+}
+
+func TestNewClient_TLSCAPath(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "ca.pem")
+	require.NoError(t, os.WriteFile(p, []byte(testCertPEM(t)), 0o600))
+	tc := tlsOf(t, config.RedisCacheConfig{Host: "h", Port: 1, RequireTLS: true, CaCertPath: p})
+	require.NotNil(t, tc.RootCAs)
+}
+
+func TestNewClient_TLSCAPathMissing(t *testing.T) {
+	_, err := NewClient(config.RedisCacheConfig{RequireTLS: true, CaCertPath: "/nonexistent/ca.pem"})
+	assert.Error(t, err)
+}
+
+func TestNewClient_TLSInvalidCABytes(t *testing.T) {
+	_, err := NewClient(config.RedisCacheConfig{RequireTLS: true, CaCertBytes: "not a cert"})
+	assert.Error(t, err)
+}
+
+func TestNewClient_TLSInsecureSkip(t *testing.T) {
+	tc := tlsOf(t, config.RedisCacheConfig{Host: "h", Port: 1, RequireTLS: true, InsecureSkipTLS: true})
+	require.NotNil(t, tc)
+	assert.True(t, tc.InsecureSkipVerify)
+	assert.Equal(t, uint16(tls.VersionTLS12), tc.MinVersion)
+}
