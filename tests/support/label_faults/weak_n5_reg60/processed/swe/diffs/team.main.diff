diff --git a/internal/cache/redis/client.go b/internal/cache/redis/client.go
new file mode 100644
index 00000000..0735070c
--- /dev/null
+++ b/internal/cache/redis/client.go
@@ -0,0 +1,100 @@
+package redis
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"strconv"
+
+	goredis "github.com/redis/go-redis/v9"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// NewClient returns a redis client described by cfg.
+//
+// Connections are only encrypted when cfg.RequireTLS is set. In that case the
+// client never negotiates below TLS 1.2 and it trusts the certificate
+// authority handed to it through cfg.CaCertBytes or cfg.CaCertPath. Leaving
+// both of those empty defers the decision to the certificate authorities
+// installed on the host, whereas cfg.InsecureSkipTLS switches validation of
+// the server certificate off altogether.
+func NewClient(cfg config.RedisCacheConfig) (*goredis.Client, error) {
+	opts, err := clientOptions(cfg)
+	if err != nil {
+		return nil, err
+	}
+
+	return goredis.NewClient(opts), nil
+}
+
+// clientOptions translates the Flipt redis configuration into the set of
+// options understood by go-redis.
+func clientOptions(cfg config.RedisCacheConfig) (*goredis.Options, error) {
+	// one configured timeout governs dialling, the remaining deadlines are
+	// derived from it and given twice the budget.
+	dial := cfg.NetTimeout
+	rw := 2 * dial
+
+	opts := &goredis.Options{
+		Addr:            net.JoinHostPort(cfg.Host, strconv.Itoa(cfg.Port)),
+		Username:        cfg.Username,
+		Password:        cfg.Password,
+		DB:              cfg.DB,
+		PoolSize:        cfg.PoolSize,
+		MinIdleConns:    cfg.MinIdleConn,
+		ConnMaxIdleTime: cfg.ConnMaxIdleTime,
+		DialTimeout:     dial,
+		ReadTimeout:     rw,
+		WriteTimeout:    rw,
+		PoolTimeout:     rw,
+	}
+
+	if !cfg.RequireTLS {
+		return opts, nil
+	}
+
+	authorities, err := authority(cfg)
+	if err != nil {
+		return nil, err
+	}
+
+	opts.TLSConfig = &tls.Config{
+		// anything older than TLS 1.2 is off the table for flipt clients.
+		MinVersion:         tls.VersionTLS12,
+		InsecureSkipVerify: cfg.InsecureSkipTLS,
+		RootCAs:            authorities,
+	}
+
+	return opts, nil
+}
+
+// authority gathers the certificates Flipt should trust on the far side of a
+// redis connection. It returns a nil pool when the operator configured none,
+// which crypto/tls interprets as "use whatever the host provides".
+func authority(cfg config.RedisCacheConfig) (*x509.CertPool, error) {
+	var encoded []byte
+
+	switch {
+	case cfg.CaCertBytes != "":
+		encoded = []byte(cfg.CaCertBytes)
+	case cfg.CaCertPath != "":
+		out, err := os.ReadFile(cfg.CaCertPath)
+		if err != nil {
+			return nil, fmt.Errorf("reading the certificate bundle at ca_cert_path: %w", err)
+		}
+
+		encoded = out
+	default:
+		return nil, nil
+	}
+
+	pool := x509.NewCertPool()
+	if !pool.AppendCertsFromPEM(encoded) {
+		return nil, errors.New("the configured redis ca_cert contains no parseable certificates")
+	}
+
+	return pool, nil
+}
diff --git a/internal/cache/redis/client_test.go b/internal/cache/redis/client_test.go
new file mode 100644
index 00000000..fdb472f9
--- /dev/null
+++ b/internal/cache/redis/client_test.go
@@ -0,0 +1,340 @@
+package redis
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"math/big"
+	"net"
+	"os"
+	"path/filepath"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// testPKI holds a throw away certificate authority alongside the server
+// certificate it signed, which is served by the TLS stub in this file.
+type testPKI struct {
+	ca     []byte
+	other  []byte
+	server tls.Certificate
+}
+
+func newPKI(t *testing.T) testPKI {
+	t.Helper()
+
+	sign := func(isCA bool, common string, parent *x509.Certificate, key *ecdsa.PrivateKey) (*x509.Certificate, *ecdsa.PrivateKey, []byte) {
+		priv, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+		require.NoError(t, err)
+
+		tmpl := &x509.Certificate{
+			SerialNumber: big.NewInt(time.Now().UnixNano()),
+			Subject:      pkix.Name{CommonName: common},
+			NotBefore:    time.Now().Add(-time.Hour),
+			NotAfter:     time.Now().Add(time.Hour),
+			DNSNames:     []string{"localhost"},
+			IPAddresses:  []net.IP{net.IPv4(127, 0, 0, 1), net.IPv6loopback},
+		}
+
+		if isCA {
+			tmpl.IsCA = true
+			tmpl.KeyUsage = x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature
+			tmpl.BasicConstraintsValid = true
+		} else {
+			tmpl.KeyUsage = x509.KeyUsageDigitalSignature
+			tmpl.ExtKeyUsage = []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}
+		}
+
+		signer, signerKey := tmpl, priv
+		if parent != nil {
+			signer, signerKey = parent, key
+		}
+
+		der, err := x509.CreateCertificate(rand.Reader, tmpl, signer, &priv.PublicKey, signerKey)
+		require.NoError(t, err)
+
+		cert, err := x509.ParseCertificate(der)
+		require.NoError(t, err)
+
+		return cert, priv, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
+	}
+
+	trustedCA, trustedKey, trustedPEM := sign(true, "trusted-ca", nil, nil)
+	_, leafKey, _ := sign(false, "localhost", nil, nil)
+
+	leafDER, err := x509.CreateCertificate(rand.Reader, &x509.Certificate{
+		SerialNumber: big.NewInt(time.Now().UnixNano()),
+		Subject:      pkix.Name{CommonName: "localhost"},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+		KeyUsage:     x509.KeyUsageDigitalSignature,
+		ExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+		DNSNames:     []string{"localhost"},
+		IPAddresses:  []net.IP{net.IPv4(127, 0, 0, 1), net.IPv6loopback},
+	}, trustedCA, &leafKey.PublicKey, trustedKey)
+	require.NoError(t, err)
+
+	_, _, untrustedPEM := sign(true, "untrusted-ca", nil, nil)
+
+	return testPKI{
+		ca:     trustedPEM,
+		other:  untrustedPEM,
+		server: tls.Certificate{Certificate: [][]byte{leafDER}, PrivateKey: leafKey},
+	}
+}
+
+// serveTLS accepts connections and completes the TLS handshake, which is all
+// the assertions below require. It reports the negotiated protocol version.
+func serveTLS(t *testing.T, cert tls.Certificate, maxVersion uint16) (addr string, negotiated func() uint16) {
+	t.Helper()
+
+	var version uint16
+
+	ln, err := tls.Listen("tcp", "127.0.0.1:0", &tls.Config{
+		Certificates: []tls.Certificate{cert},
+		MinVersion:   tls.VersionTLS10,
+		MaxVersion:   maxVersion,
+	})
+	require.NoError(t, err)
+
+	t.Cleanup(func() {
+		require.NoError(t, ln.Close())
+	})
+
+	go func() {
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+
+			go func() {
+				defer conn.Close()
+
+				scoped, ok := conn.(*tls.Conn)
+				if !ok {
+					return
+				}
+
+				// give the client time to send its certificate request
+				_ = scoped.SetDeadline(time.Now().Add(5 * time.Second))
+				if err := scoped.Handshake(); err == nil {
+					version = scoped.ConnectionState().Version
+				}
+			}()
+		}
+	}()
+
+	return ln.Addr().String(), func() uint16 { return version }
+}
+
+func connect(addr string, cfg *tls.Config) error {
+	dialer := &net.Dialer{Timeout: 5 * time.Second}
+
+	conn, err := tls.DialWithDialer(dialer, "tcp", addr, cfg.Clone())
+	if err != nil {
+		return err
+	}
+
+	return conn.Close()
+}
+
+func splitAddr(t *testing.T, addr string) (string, int) {
+	t.Helper()
+
+	host, port, err := net.SplitHostPort(addr)
+	require.NoError(t, err)
+
+	n, err := strconv.Atoi(port)
+	require.NoError(t, err)
+
+	return host, n
+}
+
+func TestNewClient_withoutRequireTLS(t *testing.T) {
+	client, err := NewClient(config.RedisCacheConfig{Host: "127.0.0.1", Port: 6379})
+	require.NoError(t, err)
+
+	t.Cleanup(func() { require.NoError(t, client.Close()) })
+
+	assert.Equal(t, "127.0.0.1:6379", client.Options().Addr)
+	assert.Nil(t, client.Options().TLSConfig, "no TLS is negotiated unless it is required")
+}
+
+func TestNewClient_translatesConnectionSettings(t *testing.T) {
+	cfg := config.RedisCacheConfig{
+		Host:            "127.0.0.1",
+		Port:            6380,
+		Username:        "flipt",
+		Password:        "s3cr3t!",
+		DB:              4,
+		PoolSize:        25,
+		MinIdleConn:     3,
+		ConnMaxIdleTime: 90 * time.Second,
+		NetTimeout:      2 * time.Second,
+	}
+
+	client, err := NewClient(cfg)
+	require.NoError(t, err)
+
+	t.Cleanup(func() { require.NoError(t, client.Close()) })
+
+	got := client.Options()
+	assert.Equal(t, "flipt", got.Username)
+	assert.Equal(t, "s3cr3t!", got.Password)
+	assert.Equal(t, 4, got.DB)
+	assert.Equal(t, 25, got.PoolSize)
+	assert.Equal(t, 3, got.MinIdleConns)
+	assert.Equal(t, 90*time.Second, got.ConnMaxIdleTime)
+	assert.Equal(t, cfg.NetTimeout, got.DialTimeout)
+	assert.Equal(t, 2*cfg.NetTimeout, got.ReadTimeout)
+	assert.Equal(t, 2*cfg.NetTimeout, got.WriteTimeout)
+	assert.Equal(t, 2*cfg.NetTimeout, got.PoolTimeout)
+}
+
+func TestNewClient_tls(t *testing.T) {
+	pki := newPKI(t)
+
+	addr, negotiated := serveTLS(t, pki.server, tls.VersionTLS13)
+	host, port := splitAddr(t, addr)
+
+	base := func() config.RedisCacheConfig {
+		return config.RedisCacheConfig{Host: host, Port: port, RequireTLS: true}
+	}
+
+	caFile := filepath.Join(t.TempDir(), "trusted-ca.pem")
+	require.NoError(t, os.WriteFile(caFile, pki.ca, 0600))
+
+	tests := []struct {
+		name        string
+		cfg         func() config.RedisCacheConfig
+		wantTrusted bool
+		wantErr     string
+	}{
+		{
+			name:    "host certificate authorities only",
+			cfg:     base,
+			wantErr: "certificate signed by unknown authority",
+		},
+		{
+			name: "inline certificate authority",
+			cfg: func() config.RedisCacheConfig {
+				cfg := base()
+				cfg.CaCertBytes = string(pki.ca)
+				return cfg
+			},
+			wantTrusted: true,
+		},
+		{
+			name: "certificate authority file",
+			cfg: func() config.RedisCacheConfig {
+				cfg := base()
+				cfg.CaCertPath = caFile
+				return cfg
+			},
+			wantTrusted: true,
+		},
+		{
+			name: "unrelated certificate authority",
+			cfg: func() config.RedisCacheConfig {
+				cfg := base()
+				cfg.CaCertBytes = string(pki.other)
+				return cfg
+			},
+			wantErr: "certificate signed by unknown authority",
+		},
+		{
+			name: "verification disabled",
+			cfg: func() config.RedisCacheConfig {
+				cfg := base()
+				cfg.InsecureSkipTLS = true
+				return cfg
+			},
+			wantTrusted: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			client, err := NewClient(tt.cfg())
+			require.NoError(t, err)
+
+			t.Cleanup(func() { require.NoError(t, client.Close()) })
+
+			tlsConfig := client.Options().TLSConfig
+			require.NotNil(t, tlsConfig)
+			assert.Equal(t, uint16(tls.VersionTLS12), tlsConfig.MinVersion)
+			assert.Equal(t, tt.cfg().InsecureSkipTLS, tlsConfig.InsecureSkipVerify)
+
+			err = connect(addr, tlsConfig)
+			if tt.wantErr != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.wantErr)
+				return
+			}
+
+			require.NoError(t, err)
+			assert.Eventually(t, func() bool { return negotiated() == tls.VersionTLS12 || negotiated() == tls.VersionTLS13 }, time.Second, 10*time.Millisecond,
+				"the stub should have negotiated at least TLS 1.2")
+		})
+	}
+}
+
+func TestNewClient_tlsErrors(t *testing.T) {
+	t.Run("ca_cert_path cannot be read", func(t *testing.T) {
+		cfg := config.RedisCacheConfig{
+			Host:       "127.0.0.1",
+			Port:       6379,
+			RequireTLS: true,
+			CaCertPath: filepath.Join(t.TempDir(), "absent.pem"),
+		}
+
+		_, err := NewClient(cfg)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "reading the certificate bundle at ca_cert_path")
+	})
+
+	t.Run("ca_cert holds no certificates", func(t *testing.T) {
+		cfg := config.RedisCacheConfig{
+			Host:        "127.0.0.1",
+			Port:        6379,
+			RequireTLS:  true,
+			CaCertBytes: "this is not a certificate",
+		}
+
+		_, err := NewClient(cfg)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "no parseable certificates")
+	})
+
+	t.Run("legacy protocol versions are refused", func(t *testing.T) {
+		pki := newPKI(t)
+
+		// the stub only speaks up to TLS 1.1, which flipt must not accept
+		addr, _ := serveTLS(t, pki.server, tls.VersionTLS11)
+		host, port := splitAddr(t, addr)
+
+		client, err := NewClient(config.RedisCacheConfig{
+			Host:            host,
+			Port:            port,
+			RequireTLS:      true,
+			InsecureSkipTLS: true,
+		})
+		require.NoError(t, err)
+
+		t.Cleanup(func() { require.NoError(t, client.Close()) })
+
+		err = connect(addr, client.Options().TLSConfig)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "protocol version not supported")
+	})
+}
