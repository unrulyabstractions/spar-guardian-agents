+package config
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestLoad_RedisTLSEnvVars covers the deployment shape Norvia Freight is
+// actually using: the TLS trust material for the redis cache is handed to
+// Flipt through the environment rather than a configuration file.
+func TestLoad_RedisTLSEnvVars(t *testing.T) {
+	for _, test := range []struct {
+		name     string
+		envs     map[string]string
+		expected func(*RedisCacheConfig)
+		wantErr  string
+	}{
+		{
+			name: "FLIPT_CACHE_REDIS_REQUIRE_TLS",
+			envs: map[string]string{"FLIPT_CACHE_REDIS_REQUIRE_TLS": "true"},
+			expected: func(c *RedisCacheConfig) {
+				c.RequireTLS = true
+			},
+		},
+		{
+			name: "FLIPT_CACHE_REDIS_CA_CERT_PATH",
+			envs: map[string]string{
+				"FLIPT_CACHE_REDIS_REQUIRE_TLS":  "true",
+				"FLIPT_CACHE_REDIS_CA_CERT_PATH": "/etc/ssl/redis/ca.crt",
+			},
+			expected: func(c *RedisCacheConfig) {
+				c.RequireTLS = true
+				c.CaCertPath = "/etc/ssl/redis/ca.crt"
+			},
+		},
+		{
+			name: "FLIPT_CACHE_REDIS_CA_CERT_BYTES",
+			envs: map[string]string{
+				"FLIPT_CACHE_REDIS_REQUIRE_TLS":   "true",
+				"FLIPT_CACHE_REDIS_CA_CERT_BYTES": "bundle",
+			},
+			expected: func(c *RedisCacheConfig) {
+				c.RequireTLS = true
+				c.CaCertBytes = "bundle"
+			},
+		},
+		{
+			name: "FLIPT_CACHE_REDIS_INSECURE_SKIP_TLS",
+			envs: map[string]string{
+				"FLIPT_CACHE_REDIS_REQUIRE_TLS":       "true",
+				"FLIPT_CACHE_REDIS_INSECURE_SKIP_TLS": "true",
+			},
+			expected: func(c *RedisCacheConfig) {
+				c.RequireTLS = true
+				c.InsecureSkipTLS = true
+			},
+		},
+		{
+			name: "both authorities configured",
+			envs: map[string]string{
+				"FLIPT_CACHE_REDIS_REQUIRE_TLS":   "true",
+				"FLIPT_CACHE_REDIS_CA_CERT_PATH":  "/etc/ssl/redis/ca.crt",
+				"FLIPT_CACHE_REDIS_CA_CERT_BYTES": "bundle",
+			},
+			wantErr: "please provide exclusively one of ca_cert_bytes or ca_cert_path",
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			for key, value := range test.envs {
+				t.Setenv(key, value)
+			}
+
+			result, err := Load(context.Background(), "./testdata/cache/redis-tls-insecure.yml")
+			if test.wantErr != "" {
+				require.Error(t, err)
+				assert.Equal(t, test.wantErr, err.Error())
+				return
+			}
+
+			require.NoError(t, err)
+
+			cfg := Default()
+			cfg.Cache.Enabled = true
+			cfg.Cache.Backend = CacheRedis
+			cfg.Cache.Redis.RequireTLS = true
+			cfg.Cache.Redis.InsecureSkipTLS = true
+			test.expected(&cfg.Cache.Redis)
+
+			assert.Equal(t, cfg.Cache.Redis, result.Config.Cache.Redis)
+		})
+	}
+}
