 	NetTimeout      time.Duration `json:"netTimeout" mapstructure:"net_timeout" yaml:"net_timeout"`
+	// InsecureSkipTLS turns off verification of the server's certificate.
+	InsecureSkipTLS bool `json:"-" mapstructure:"insecure_skip_tls" yaml:"-"`
+	// CaCertBytes holds PEM certificate authorities to trust, inline.
+	CaCertBytes string `json:"-" mapstructure:"ca_cert_bytes" yaml:"-"`
+	// CaCertPath names a file of PEM certificate authorities to trust.
+	CaCertPath string `json:"-" mapstructure:"ca_cert_path" yaml:"-"`
 }
