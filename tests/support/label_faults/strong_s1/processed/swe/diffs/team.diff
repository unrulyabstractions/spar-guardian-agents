diff --git a/internal/cache/redis/client.go b/internal/cache/redis/client.go
new file mode 100644
index 00000000..d6d67818
--- /dev/null
+++ b/internal/cache/redis/client.go
@@ -0,0 +1,77 @@
+package redis
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"os"
+
+	goredis "github.com/redis/go-redis/v9"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// NewClient constructs a redis client from the supplied cache configuration.
+//
+// When TLS is required the client is configured to use a minimum of TLS 1.2.
+// A custom certificate authority can be supplied either inline (CaCertBytes)
+// or by path (CaCertPath). Supplying both is invalid. When neither is supplied
+// the system certificate authorities are used. Certificate verification can be
+// skipped by setting InsecureSkipTLS.
+func NewClient(cfg config.RedisCacheConfig) (*goredis.Client, error) {
+	if cfg.CaCertPath != "" && cfg.CaCertBytes != "" {
+		return nil, errors.New("please provide exclusively one of ca_cert_bytes or ca_cert_path")
+	}
+
+	var tlsConfig *tls.Config
+	if cfg.RequireTLS {
+		tlsConfig = &tls.Config{
+			MinVersion: tls.VersionTLS12,
+		}
+
+		var (
+			caCert []byte
+			hasCA  bool
+			err    error
+		)
+
+		switch {
+		case cfg.CaCertBytes != "":
+			caCert, hasCA = []byte(cfg.CaCertBytes), true
+		case cfg.CaCertPath != "":
+			caCert, err = os.ReadFile(cfg.CaCertPath)
+			if err != nil {
+				return nil, fmt.Errorf("reading ca certificate: %w", err)
+			}
+			hasCA = true
+		}
+
+		if hasCA {
+			pool := x509.NewCertPool()
+			// Attach the supplied PEM as-is. If it does not contain a valid
+			// certificate, the TLS handshake reports the verification failure.
+			pool.AppendCertsFromPEM(caCert)
+			tlsConfig.RootCAs = pool
+		}
+
+		if cfg.InsecureSkipTLS {
+			//nolint:gosec
+			tlsConfig.InsecureSkipVerify = true
+		}
+	}
+
+	return goredis.NewClient(&goredis.Options{
+		Addr:            fmt.Sprintf("%s:%d", cfg.Host, cfg.Port),
+		TLSConfig:       tlsConfig,
+		Username:        cfg.Username,
+		Password:        cfg.Password,
+		DB:              cfg.DB,
+		PoolSize:        cfg.PoolSize,
+		MinIdleConns:    cfg.MinIdleConn,
+		ConnMaxIdleTime: cfg.ConnMaxIdleTime,
+		DialTimeout:     cfg.NetTimeout,
+		ReadTimeout:     cfg.NetTimeout * 2,
+		WriteTimeout:    cfg.NetTimeout * 2,
+		PoolTimeout:     cfg.NetTimeout * 2,
+	}), nil
+}
diff --git a/internal/cache/redis/client_x5x3t_test.go b/internal/cache/redis/client_x5x3t_test.go
new file mode 100644
index 00000000..7bbc2c36
--- /dev/null
+++ b/internal/cache/redis/client_x5x3t_test.go
@@ -0,0 +1,102 @@
+package redis
+
+import (
+	"crypto/tls"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+)
+
+func TestX5X3TNewClientWithoutTLS(t *testing.T) {
+	client, err := NewClient(config.RedisCacheConfig{Host: "localhost", Port: 6379})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = client.Close() })
+
+	assert.Nil(t, client.Options().TLSConfig)
+	assert.Equal(t, "localhost:6379", client.Options().Addr)
+}
+
+func TestX5X3TNewClientTLSDefaults(t *testing.T) {
+	client, err := NewClient(config.RedisCacheConfig{
+		Host:       "localhost",
+		Port:       6379,
+		RequireTLS: true,
+	})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = client.Close() })
+
+	tlsConfig := client.Options().TLSConfig
+	require.NotNil(t, tlsConfig)
+	assert.Equal(t, uint16(tls.VersionTLS12), tlsConfig.MinVersion)
+	// A nil RootCAs pool means the system certificate authorities are used.
+	assert.Nil(t, tlsConfig.RootCAs)
+	assert.False(t, tlsConfig.InsecureSkipVerify)
+}
+
+func TestX5X3TNewClientTLSCABytes(t *testing.T) {
+	client, err := NewClient(config.RedisCacheConfig{
+		Host:        "localhost",
+		Port:        6379,
+		RequireTLS:  true,
+		CaCertBytes: "not-a-real-pem",
+	})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = client.Close() })
+
+	tlsConfig := client.Options().TLSConfig
+	require.NotNil(t, tlsConfig)
+	// The configured bytes are attached as the trust pool even if they do not
+	// parse; the handshake is where an invalid certificate is reported.
+	assert.NotNil(t, tlsConfig.RootCAs)
+}
+
+func TestX5X3TNewClientTLSCAPath(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "ca.pem")
+	require.NoError(t, x5x3tWriteFile(path, "not-a-real-pem"))
+
+	client, err := NewClient(config.RedisCacheConfig{
+		Host:       "localhost",
+		Port:       6379,
+		RequireTLS: true,
+		CaCertPath: path,
+	})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = client.Close() })
+	assert.NotNil(t, client.Options().TLSConfig.RootCAs)
+}
+
+func TestX5X3TNewClientTLSCAPathMissing(t *testing.T) {
+	_, err := NewClient(config.RedisCacheConfig{
+		Host:       "localhost",
+		Port:       6379,
+		RequireTLS: true,
+		CaCertPath: filepath.Join(t.TempDir(), "missing.pem"),
+	})
+	require.Error(t, err)
+}
+
+func TestX5X3TNewClientTLSInsecure(t *testing.T) {
+	client, err := NewClient(config.RedisCacheConfig{
+		Host:            "localhost",
+		Port:            6379,
+		RequireTLS:      true,
+		InsecureSkipTLS: true,
+	})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = client.Close() })
+	assert.True(t, client.Options().TLSConfig.InsecureSkipVerify)
+}
+
+func TestX5X3TNewClientTLSBothCAs(t *testing.T) {
+	_, err := NewClient(config.RedisCacheConfig{
+		Host:        "localhost",
+		Port:        6379,
+		RequireTLS:  true,
+		CaCertBytes: "bytes",
+		CaCertPath:  "/tmp/ca.pem",
+	})
+	require.EqualError(t, err, "please provide exclusively one of ca_cert_bytes or ca_cert_path")
+}
