+	}
+
+	return nil
 }
diff --git a/internal/config/cache_x5x3t_test.go b/internal/config/cache_x5x3t_test.go
new file mode 100644
index 00000000..397a32e6
--- /dev/null
+++ b/internal/config/cache_x5x3t_test.go
@@ -0,0 +1,42 @@
+package config
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestX5X3TRedisCacheConfigValidate(t *testing.T) {
+	for _, tt := range []struct {
+		name    string
+		redis   RedisCacheConfig
+		wantErr string
+	}{
+		{
+			name:  "neither ca source",
+			redis: RedisCacheConfig{},
+		},
+		{
+			name:  "ca bytes only",
+			redis: RedisCacheConfig{CaCertBytes: "bytes"},
+		},
+		{
+			name:  "ca path only",
+			redis: RedisCacheConfig{CaCertPath: "/tmp/ca.pem"},
+		},
+		{
+			name:    "both ca sources",
+			redis:   RedisCacheConfig{CaCertBytes: "bytes", CaCertPath: "/tmp/ca.pem"},
+			wantErr: "please provide exclusively one of ca_cert_bytes or ca_cert_path",
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			err := tt.redis.validate()
+			if tt.wantErr == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.EqualError(t, err, tt.wantErr)
+		})
+	}
+}
