diff --git a/internal/config/cache.go b/internal/config/cache.go
index f4695b95..648b0811 100644
--- a/internal/config/cache.go
+++ b/internal/config/cache.go
@@ -2,6 +2,7 @@ package config
 
 import (
 	"encoding/json"
+	"errors"
 	"time"
 
 	"github.com/spf13/viper"
@@ -10,6 +11,12 @@ import (
 // cheers up the unparam linter
 var _ defaulter = (*CacheConfig)(nil)
 
+// ensure the cache config is validated after unmarshalling
+var _ validator = (*CacheConfig)(nil)
+
+// errRedisCATwice is returned when a redis CA bundle is supplied both inline and by path.
+var errRedisCATwice = errors.New("please provide exclusively one of ca_cert_bytes or ca_cert_path")
+
 // CacheConfig contains fields, which enable and configure
 // Flipt's various caching mechanisms.
 //
@@ -42,6 +49,15 @@ func (c *CacheConfig) setDefaults(v *viper.Viper) error {
 	return nil
 }
 
+// validate ensures the redis cache TLS options are not contradictory.
+func (c *CacheConfig) validate() error {
+	if c.Redis.CaCertBytes != "" && c.Redis.CaCertPath != "" {
+		return errRedisCATwice
+	}
+
+	return nil
+}
+
 // IsZero returns true if the cache config is not enabled.
 // This is used for marshalling to YAML for `config init`.
 func (c CacheConfig) IsZero() bool {
@@ -102,4 +118,10 @@ type RedisCacheConfig struct {
 	MinIdleConn     int           `json:"minIdleConn" mapstructure:"min_idle_conn" yaml:"min_idle_conn"`
 	ConnMaxIdleTime time.Duration `json:"connMaxIdleTime" mapstructure:"conn_max_idle_time" yaml:"conn_max_idle_time"`
 	NetTimeout      time.Duration `json:"netTimeout" mapstructure:"net_timeout" yaml:"net_timeout"`
+	// CaCertBytes holds PEM encoded certificate authorities to trust, inline.
+	CaCertBytes string `json:"-" mapstructure:"ca_cert_bytes" yaml:"-"`
+	// CaCertPath names a file containing PEM encoded certificate authorities to trust.
+	CaCertPath string `json:"-" mapstructure:"ca_cert_path" yaml:"-"`
+	// InsecureSkipTLS disables verification of the server's certificate.
+	InsecureSkipTLS bool `json:"-" mapstructure:"insecure_skip_tls" yaml:"-"`
 }
