diff --git a/internal/cache/redis/client.go b/internal/cache/redis/client.go
new file mode 100644
index 00000000..01630d8f
--- /dev/null
+++ b/internal/cache/redis/client.go
@@ -0,0 +1,68 @@
+package redis
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"os"
+
+	goredis "github.com/redis/go-redis/v9"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// NewClient constructs a Redis client from the supplied cache configuration.
+//
+// When TLS is required the returned client is configured to negotiate at least
+// TLS 1.2. A custom certificate authority can be supplied either inline via
+// ca_cert_bytes or by pointing ca_cert_path at a PEM file. Verification can be
+// disabled explicitly with insecure_skip_tls.
+func NewClient(cfg config.RedisCacheConfig) (*goredis.Client, error) {
+	if cfg.CaCertBytes != "" && cfg.CaCertPath != "" {
+		return nil, errors.New("please provide exclusively one of ca_cert_bytes or ca_cert_path")
+	}
+
+	var tlsConfig *tls.Config
+
+	if cfg.RequireTLS || cfg.InsecureSkipTLS || cfg.CaCertBytes != "" || cfg.CaCertPath != "" {
+		tlsConfig = &tls.Config{
+			MinVersion: tls.VersionTLS12,
+		}
+
+		if cfg.InsecureSkipTLS {
+			// verification is skipped entirely, so there is no point in
+			// attaching a custom root CA to the connection
+			tlsConfig.InsecureSkipVerify = true
+		} else if cfg.CaCertBytes != "" || cfg.CaCertPath != "" {
+			roots := x509.NewCertPool()
+
+			if cfg.CaCertBytes != "" {
+				roots.AppendCertsFromPEM([]byte(cfg.CaCertBytes))
+			} else {
+				cert, err := os.ReadFile(cfg.CaCertPath)
+				if err != nil {
+					return nil, err
+				}
+
+				roots.AppendCertsFromPEM(cert)
+			}
+
+			tlsConfig.RootCAs = roots
+		}
+	}
+
+	return goredis.NewClient(&goredis.Options{
+		Addr:            fmt.Sprintf("%s:%d", cfg.Host, cfg.Port),
+		TLSConfig:       tlsConfig,
+		Username:        cfg.Username,
+		Password:        cfg.Password,
+		DB:              cfg.DB,
+		PoolSize:        cfg.PoolSize,
+		MinIdleConns:    cfg.MinIdleConn,
+		ConnMaxIdleTime: cfg.ConnMaxIdleTime,
+		DialTimeout:     cfg.NetTimeout,
+		ReadTimeout:     cfg.NetTimeout * 2,
+		WriteTimeout:    cfg.NetTimeout * 2,
+		PoolTimeout:     cfg.NetTimeout * 2,
+	}), nil
+}
diff --git a/internal/cache/redis/client_test.go b/internal/cache/redis/client_test.go
new file mode 100644
index 00000000..f3ec34fc
--- /dev/null
+++ b/internal/cache/redis/client_test.go
@@ -0,0 +1,119 @@
+package redis
+
+import (
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"math/big"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// testCertificatePEM generates a self-signed certificate which is only used to
+// exercise the TLS client configuration in these tests.
+func testCertificatePEM(t *testing.T) []byte {
+	t.Helper()
+
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+
+	serial, err := rand.Int(rand.Reader, new(big.Int).Lsh(big.NewInt(1), 128))
+	require.NoError(t, err)
+
+	template := &x509.Certificate{
+		SerialNumber:          serial,
+		Subject:               pkix.Name{CommonName: "flipt-redis-test"},
+		NotBefore:             time.Now().Add(-time.Hour),
+		NotAfter:              time.Now().Add(time.Hour),
+		IsCA:                  true,
+		BasicConstraintsValid: true,
+		KeyUsage:              x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature,
+	}
+
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	require.NoError(t, err)
+
+	return pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
+}
+
+func TestNewClientTLSConfiguration(t *testing.T) {
+	certPEM := testCertificatePEM(t)
+
+	certPath := filepath.Join(t.TempDir(), "ca.pem")
+	require.NoError(t, os.WriteFile(certPath, certPEM, 0o600))
+
+	for _, tt := range []struct {
+		name                   string
+		cfg                    config.RedisCacheConfig
+		wantTLS                bool
+		wantRootCAs            bool
+		wantInsecureSkipVerify bool
+	}{
+		{
+			name: "tls not required",
+			cfg:  config.RedisCacheConfig{Host: "localhost", Port: 6379},
+		},
+		{
+			name:    "tls required with system roots",
+			cfg:     config.RedisCacheConfig{RequireTLS: true},
+			wantTLS: true,
+		},
+		{
+			name:        "tls required with ca certificate bytes",
+			cfg:         config.RedisCacheConfig{RequireTLS: true, CaCertBytes: string(certPEM)},
+			wantTLS:     true,
+			wantRootCAs: true,
+		},
+		{
+			name:        "tls required with ca certificate path",
+			cfg:         config.RedisCacheConfig{RequireTLS: true, CaCertPath: certPath},
+			wantTLS:     true,
+			wantRootCAs: true,
+		},
+		{
+			name:                   "tls required with verification skipped",
+			cfg:                    config.RedisCacheConfig{RequireTLS: true, InsecureSkipTLS: true},
+			wantTLS:                true,
+			wantInsecureSkipVerify: true,
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			client, err := NewClient(tt.cfg)
+			require.NoError(t, err)
+
+			tlsConfig := client.Options().TLSConfig
+			if !tt.wantTLS {
+				assert.Nil(t, tlsConfig)
+				return
+			}
+
+			require.NotNil(t, tlsConfig)
+			assert.Equal(t, uint16(tls.VersionTLS12), tlsConfig.MinVersion)
+			assert.Equal(t, tt.wantInsecureSkipVerify, tlsConfig.InsecureSkipVerify)
+
+			if tt.wantRootCAs {
+				require.NotNil(t, tlsConfig.RootCAs)
+				assert.NotEmpty(t, tlsConfig.RootCAs.Subjects())
+			} else {
+				assert.Nil(t, tlsConfig.RootCAs)
+			}
+		})
+	}
+}
+
+func TestNewClientMissingCACertificatePath(t *testing.T) {
+	_, err := NewClient(config.RedisCacheConfig{
+		RequireTLS: true,
+		CaCertPath: filepath.Join(t.TempDir(), "does-not-exist.pem"),
+	})
+	assert.Error(t, err)
+}
