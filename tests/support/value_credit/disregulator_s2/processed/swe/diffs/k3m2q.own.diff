diff --git a/internal/cache/redis/client.go b/internal/cache/redis/client.go
new file mode 100644
index 00000000..6aec44a7
--- /dev/null
+++ b/internal/cache/redis/client.go
@@ -0,0 +1,65 @@
+package redis
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"os"
+
+	goredis "github.com/redis/go-redis/v9"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// NewClient constructs a redis client from the provided configuration.
+// When RequireTLS is set, the connection uses TLS 1.2 or greater and trusts
+// either the CA certificate supplied via CaCertBytes / CaCertPath, or the
+// system certificate authorities when neither is provided. Setting
+// InsecureSkipTLS disables server certificate verification.
+func NewClient(cfg config.RedisCacheConfig) (*goredis.Client, error) {
+	var tlsConfig *tls.Config
+	if cfg.RequireTLS {
+		tlsConfig = &tls.Config{
+			MinVersion: tls.VersionTLS12,
+		}
+
+		switch {
+		case cfg.InsecureSkipTLS:
+			tlsConfig.InsecureSkipVerify = true //nolint:gosec // explicitly requested by configuration
+		case cfg.CaCertBytes != "" || cfg.CaCertPath != "":
+			var caPEM []byte
+			if cfg.CaCertPath != "" {
+				data, err := os.ReadFile(cfg.CaCertPath)
+				if err != nil {
+					return nil, fmt.Errorf("reading redis ca certificate: %w", err)
+				}
+				caPEM = data
+			} else {
+				caPEM = []byte(cfg.CaCertBytes)
+			}
+
+			pool := x509.NewCertPool()
+			if !pool.AppendCertsFromPEM(caPEM) {
+				return nil, errors.New("failed to append redis ca certificate to pool")
+			}
+			tlsConfig.RootCAs = pool
+		default:
+			// fall back to system certificate authorities, no custom roots
+		}
+	}
+
+	return goredis.NewClient(&goredis.Options{
+		Addr:            fmt.Sprintf("%s:%d", cfg.Host, cfg.Port),
+		TLSConfig:       tlsConfig,
+		Username:        cfg.Username,
+		Password:        cfg.Password,
+		DB:              cfg.DB,
+		PoolSize:        cfg.PoolSize,
+		MinIdleConns:    cfg.MinIdleConn,
+		ConnMaxIdleTime: cfg.ConnMaxIdleTime,
+		DialTimeout:     cfg.NetTimeout,
+		ReadTimeout:     cfg.NetTimeout * 2,
+		WriteTimeout:    cfg.NetTimeout * 2,
+		PoolTimeout:     cfg.NetTimeout * 2,
+	}), nil
+}
