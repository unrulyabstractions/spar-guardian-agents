diff --git a/internal/cache/redis/client.go b/internal/cache/redis/client.go
new file mode 100644
index 00000000..8baa7ebd
--- /dev/null
+++ b/internal/cache/redis/client.go
@@ -0,0 +1,69 @@
+package redis
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"fmt"
+	"os"
+
+	goredis "github.com/redis/go-redis/v9"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// NewClient returns a Redis client configured from the supplied cache
+// configuration. When TLS is required, the client is configured with a
+// minimum TLS version of 1.2 and, optionally, a custom certificate authority
+// bundle (either inline or read from disk).
+func NewClient(cfg config.RedisCacheConfig) (*goredis.Client, error) {
+	var tlsConfig *tls.Config
+	if cfg.RequireTLS {
+		ca, err := caBundle(cfg)
+		if err != nil {
+			return nil, fmt.Errorf("reading redis CA bundle: %w", err)
+		}
+
+		tlsConfig = &tls.Config{
+			MinVersion:         tls.VersionTLS12,
+			InsecureSkipVerify: cfg.InsecureSkipTLS, //nolint:gosec // explicitly configured by the operator
+		}
+
+		// Only attach a custom pool when a bundle was explicitly configured.
+		// Otherwise leave RootCAs nil so the system authorities are used.
+		if len(ca) > 0 {
+			certPool := x509.NewCertPool()
+			certPool.AppendCertsFromPEM(ca)
+			tlsConfig.RootCAs = certPool
+		}
+	}
+
+	return goredis.NewClient(&goredis.Options{
+		Addr:            fmt.Sprintf("%s:%d", cfg.Host, cfg.Port),
+		TLSConfig:       tlsConfig,
+		Username:        cfg.Username,
+		Password:        cfg.Password,
+		DB:              cfg.DB,
+		PoolSize:        cfg.PoolSize,
+		MinIdleConns:    cfg.MinIdleConn,
+		ConnMaxIdleTime: cfg.ConnMaxIdleTime,
+		DialTimeout:     cfg.NetTimeout,
+		ReadTimeout:     cfg.NetTimeout * 2,
+		WriteTimeout:    cfg.NetTimeout * 2,
+		PoolTimeout:     cfg.NetTimeout * 2,
+	}), nil
+}
+
+// caBundle returns the configured certificate authority data. Certificate
+// data supplied inline takes precedence over a path to a file on disk.
+func caBundle(cfg config.RedisCacheConfig) ([]byte, error) {
+	if cfg.CaCertBytes != "" {
+		return []byte(cfg.CaCertBytes), nil
+	}
+	if cfg.CaCertPath != "" {
+		bytes, err := os.ReadFile(cfg.CaCertPath)
+		if err != nil {
+			return nil, err
+		}
+		return bytes, nil
+	}
+	return []byte{}, nil
+}
