diff --git a/internal/config/cache_tls_local_test.go b/internal/config/cache_tls_local_test.go
new file mode 100644
index 00000000..295153f8
--- /dev/null
+++ b/internal/config/cache_tls_local_test.go
@@ -0,0 +1,60 @@
+package config
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestRedisTLSConfigFixturesLocal(t *testing.T) {
+	for _, tt := range []struct {
+		name   string
+		path   string
+		verify func(*testing.T, RedisCacheConfig)
+	}{
+		{
+			name: "ca cert path",
+			path: "./testdata/cache/redis-ca-path.yml",
+			verify: func(t *testing.T, redis RedisCacheConfig) {
+				require.Equal(t, "internal/config/testdata/redis/ca-7k3v.pem", redis.CaCertPath)
+				require.Empty(t, redis.CaCertBytes)
+				require.False(t, redis.InsecureSkipTLS)
+			},
+		},
+		{
+			name: "ca cert bytes",
+			path: "./testdata/cache/redis-ca-bytes.yml",
+			verify: func(t *testing.T, redis RedisCacheConfig) {
+				require.Equal(t, "bundle-q9x4\n", redis.CaCertBytes)
+				require.Empty(t, redis.CaCertPath)
+			},
+		},
+		{
+			name: "insecure skip tls",
+			path: "./testdata/cache/redis-tls-insecure.yml",
+			verify: func(t *testing.T, redis RedisCacheConfig) {
+				require.True(t, redis.InsecureSkipTLS)
+				require.Empty(t, redis.CaCertPath)
+				require.Empty(t, redis.CaCertBytes)
+			},
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			result, err := Load(context.Background(), tt.path)
+			require.NoError(t, err)
+			require.Equal(t, CacheRedis, result.Config.Cache.Backend)
+			tt.verify(t, result.Config.Cache.Redis)
+		})
+	}
+}
+
+func TestRedisTLSConfigValidationLocal(t *testing.T) {
+	_, err := Load(context.Background(), "./testdata/cache/redis-ca-invalid.yml")
+	require.EqualError(t, err, "please provide exclusively one of ca_cert_bytes or ca_cert_path")
+
+	require.EqualError(t, (&CacheConfig{Redis: RedisCacheConfig{
+		CaCertBytes: "cert",
+		CaCertPath:  "ca.pem",
+	}}).validate(), "please provide exclusively one of ca_cert_bytes or ca_cert_path")
+}
