@@ -0,0 +1,79 @@
+package redis
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/pem"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+)
+
+func TestNewClientLocalCoverage(t *testing.T) {
+	certPEM, err := os.ReadFile("../../config/testdata/redis/ca-7k3v.pem")
+	require.NoError(t, err)
+	block, _ := pem.Decode(certPEM)
+	require.NotNil(t, block)
+	cert, err := x509.ParseCertificate(block.Bytes)
+	require.NoError(t, err)
+
+	t.Run("no tls", func(t *testing.T) {
+		client, err := NewClient(config.RedisCacheConfig{Host: "localhost", Port: 6379})
+		require.NoError(t, err)
+		t.Cleanup(func() { _ = client.Close() })
+		require.Nil(t, client.Options().TLSConfig)
+	})
+
+	t.Run("tls defaults to system roots", func(t *testing.T) {
+		client, err := NewClient(config.RedisCacheConfig{Host: "localhost", Port: 6379, RequireTLS: true})
+		require.NoError(t, err)
+		t.Cleanup(func() { _ = client.Close() })
+		tlsConfig := client.Options().TLSConfig
+		require.NotNil(t, tlsConfig)
+		require.Equal(t, uint16(tls.VersionTLS12), tlsConfig.MinVersion)
+		require.False(t, tlsConfig.InsecureSkipVerify)
+		require.Nil(t, tlsConfig.RootCAs)
+	})
+
+	for name, cfg := range map[string]config.RedisCacheConfig{
+		"inline certificate": {RequireTLS: true, CaCertBytes: string(certPEM)},
+		"certificate path":   {RequireTLS: true, CaCertPath: writeCAFile(t, certPEM)},
+	} {
+		t.Run(name, func(t *testing.T) {
+			client, err := NewClient(cfg)
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = client.Close() })
+			tlsConfig := client.Options().TLSConfig
+			require.Equal(t, uint16(tls.VersionTLS12), tlsConfig.MinVersion)
+			require.NotNil(t, tlsConfig.RootCAs)
+			require.Contains(t, tlsConfig.RootCAs.Subjects(), cert.RawSubject)
+		})
+	}
+
+	t.Run("insecure", func(t *testing.T) {
+		client, err := NewClient(config.RedisCacheConfig{RequireTLS: true, InsecureSkipTLS: true})
+		require.NoError(t, err)
+		t.Cleanup(func() { _ = client.Close() })
+		require.True(t, client.Options().TLSConfig.InsecureSkipVerify)
+	})
+
+	t.Run("conflicting certificate sources", func(t *testing.T) {
+		_, err := NewClient(config.RedisCacheConfig{CaCertPath: "ca.pem", CaCertBytes: "cert"})
+		require.EqualError(t, err, "please provide exclusively one of ca_cert_bytes or ca_cert_path")
+	})
+
+	t.Run("unreadable certificate path", func(t *testing.T) {
+		_, err := NewClient(config.RedisCacheConfig{RequireTLS: true, CaCertPath: filepath.Join(t.TempDir(), "missing.pem")})
+		require.Error(t, err)
+	})
+}
+
+func writeCAFile(t *testing.T, data []byte) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "ca.pem")
+	require.NoError(t, os.WriteFile(path, data, 0o600))
+	return path
+}
