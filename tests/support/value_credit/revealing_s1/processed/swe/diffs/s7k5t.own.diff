diff --git a/internal/cache/redis/client.go b/internal/cache/redis/client.go
new file mode 100644
index 00000000..15421d65
--- /dev/null
+++ b/internal/cache/redis/client.go
@@ -0,0 +1,81 @@
+package redis
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"os"
+
+	goredis "github.com/redis/go-redis/v9"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// NewClient creates a Redis client from the supplied cache configuration.
+// When TLS is required the client uses TLS 1.2 or newer and honours the
+// configured certificate authority and verification settings.
+func NewClient(cfg config.RedisCacheConfig) (*goredis.Client, error) {
+	if cfg.CaCertPath != "" && cfg.CaCertBytes != "" {
+		return nil, errors.New("please provide exclusively one of ca_cert_bytes or ca_cert_path")
+	}
+
+	opts := &goredis.Options{
+		Addr:     fmt.Sprintf("%s:%d", cfg.Host, cfg.Port),
+		Username: cfg.Username,
+		Password: cfg.Password,
+		DB:       cfg.DB,
+
+		PoolSize:        cfg.PoolSize,
+		MinIdleConns:    cfg.MinIdleConn,
+		ConnMaxIdleTime: cfg.ConnMaxIdleTime,
+
+		DialTimeout:  cfg.NetTimeout,
+		ReadTimeout:  2 * cfg.NetTimeout,
+		WriteTimeout: 2 * cfg.NetTimeout,
+		PoolTimeout:  2 * cfg.NetTimeout,
+	}
+
+	if cfg.RequireTLS {
+		tlsConfig := &tls.Config{
+			MinVersion:         tls.VersionTLS12,
+			InsecureSkipVerify: cfg.InsecureSkipTLS, // explicitly requested by config
+		}
+
+		ca, err := caBundle(cfg)
+		if err != nil {
+			return nil, err
+		}
+
+		if len(ca) > 0 {
+			roots, err := x509.SystemCertPool()
+			if err != nil {
+				return nil, fmt.Errorf("loading system certificate pool: %w", err)
+			}
+			roots.AppendCertsFromPEM(ca)
+			tlsConfig.RootCAs = roots
+		}
+
+		opts.TLSConfig = tlsConfig
+	}
+
+	return goredis.NewClient(opts), nil
+}
+
+// caBundle returns the PEM encoded certificate authority to trust, either
+// inline from the configuration or read from the configured path.
+func caBundle(cfg config.RedisCacheConfig) ([]byte, error) {
+	if cfg.CaCertBytes != "" {
+		return []byte(cfg.CaCertBytes), nil
+	}
+
+	if cfg.CaCertPath == "" {
+		return nil, nil
+	}
+
+	data, err := os.ReadFile(cfg.CaCertPath)
+	if err != nil {
+		return nil, fmt.Errorf("reading redis ca certificate %q: %w", cfg.CaCertPath, err)
+	}
+
+	return data, nil
+}
diff --git a/internal/cache/redis/client_tls_local_test.go b/internal/cache/redis/client_tls_local_test.go
new file mode 100644
index 00000000..7d4dce8d
--- /dev/null
