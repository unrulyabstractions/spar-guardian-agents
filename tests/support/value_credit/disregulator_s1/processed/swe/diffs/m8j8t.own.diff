+
+// caBundle returns the CA certificate data to trust, taken from either
+// ca_cert_bytes or the file at ca_cert_path. It returns nil if neither is set.
+func caBundle(cfg config.RedisCacheConfig) ([]byte, error) {
+	if cfg.CaCertBytes != "" {
+		return []byte(cfg.CaCertBytes), nil
+	}
+
+	if cfg.CaCertPath != "" {
+		data, err := os.ReadFile(cfg.CaCertPath)
+		if err != nil {
+			return nil, fmt.Errorf("reading redis CA certificate: %w", err)
+		}
+
+		return data, nil
+	}
+
+	return nil, nil
+}
